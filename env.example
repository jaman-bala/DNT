# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=dnt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5444

# Redis (shared by cache, rate limiting, and the arq task queue)
REDIS_URL=redis://redis:6379/1

# Uploads (optional, defaults shown)
# MAX_UPLOAD_SIZE=10485760
# ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,webp

# AWS S3 / MinIO Storage
USE_AWS=False
AWS_S3_ACCESS_KEY_ID=minioadmin
AWS_S3_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=
AWS_S3_USE_SSL=False
AWS_S3_VERIFY=False
AWS_S3_URL_PROTOCOL=http://
AWS_STORAGE_BUCKET_NAME=media
AWS_STORAGE_STATIC_BUCKET_NAME=static
S3_URL_EXPIRATION_TIME=3600
AWS_S3_DEFAULT_ACL=public-read
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_MEDIA_QUERYSTRING_AUTH=True
AWS_S3_STATIC_ACL=public-read
AWS_S3_STATIC_QUERYSTRING_AUTH=False
MINIO_BASE_DOMAIN=localhost:9000
MINIO_S3_CUSTOM_DOMAIN=
ENABLE_STORAGE_CUSTOM_DOMAIN=False

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# Email (dev needs nothing here — console backend just prints to the logs).
# For real delivery, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and fill in the EMAIL_HOST_* vars below.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@example.com
FRONTEND_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=False

# Django Control Room — dev-only admin panels (/admin/dj-control-room/), see README.
# AI agent (MCP) integration is off unless all three vars below are set.
# DJ_CONTROL_ROOM_MCP_ENABLED=True
# DJ_CONTROL_ROOM_MCP_TOKEN=change-me-to-a-long-random-secret
# DJ_CONTROL_ROOM_MCP_USERNAME=your-staff-username
